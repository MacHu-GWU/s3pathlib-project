# comprehensive github action yml reference: https://docs.github.com/en/free-pro-team@latest/actions/reference/workflow-syntax-for-github-actions
#
# Based on the CI template of all my open source projects, plus what <package_name>
# needs: the unit tests also run against real AWS (see .github/workflows/README.rst).
#
# It uses uv only, not mise: the [env] section of mise.toml reads local secrets
# that do not exist on the runners.

---
# Name of the workflow as it will appear in the GitHub Actions tab
# ref: https://docs.github.com/en/actions/writing-workflows/workflow-syntax-for-github-actions#name
name: CI

# Define the events that will trigger this workflow to run
# ref: https://docs.github.com/en/actions/writing-workflows/workflow-syntax-for-github-actions#on
on:
  push: # Workflow will run on any push event to the main and dev branches
    branches: ["main", "dev"]
  workflow_dispatch: # Allows you to manually trigger the workflow from the GitHub UI

# The workflow only reads the repository
# ref: https://docs.github.com/en/actions/writing-workflows/workflow-syntax-for-github-actions#permissions
permissions:
  contents: read

# ------------------------------------------------------------------------------
# Custom workflow level variables
# ------------------------------------------------------------------------------
# Define environment variables at the workflow level - accessible to all jobs
env:
  PACKAGE_NAME: "<package_name>"

jobs:
  tests:
    # Dynamic name that includes the current OS and Python version from the matrix
    name: "${{ matrix.os }} Python ${{ matrix.python-version }}"
    # Specifies the runner environment (VM) for the job - dynamically set from the matrix
    # For all available VM runtime, see this: https://docs.github.com/en/free-pro-team@latest/actions/reference/specifications-for-github-hosted-runners
    runs-on: "${{ matrix.os }}"
    timeout-minutes: 30
    env: # Define environment variables that will be available to all steps in this job
      # Also run the TestRealAws classes (see <package_name>/tests/mock_aws.py).
      # Each workflow run writes to its own S3 folder (GITHUB_RUN_ID), so runs
      # of different pushes can run at the same time.
      <PACKAGE_NAME>_TEST_REAL_AWS: "true"
      # The access key of the test IAM user, set by "mise run setup-aws-ci"
      AWS_ACCESS_KEY_ID_FOR_GITHUB_CI: ${{ secrets.AWS_ACCESS_KEY_ID_FOR_GITHUB_CI }}
      AWS_SECRET_ACCESS_KEY_FOR_GITHUB_CI: ${{ secrets.AWS_SECRET_ACCESS_KEY_FOR_GITHUB_CI }}
    # ref: https://docs.github.com/en/actions/writing-workflows/workflow-syntax-for-github-actions#jobsjob_idstrategymatrix
    strategy:
      # Let the other jobs finish when one fails, to see every failing combination
      fail-fast: false
      matrix:
        # Every supported Python version on Linux and on Windows; every job also
        # runs the real AWS tests, which costs about a cent per job (see CLAUDE.md)
        include:
          - { os: "ubuntu-latest", python-version: "3.11" }
          - { os: "ubuntu-latest", python-version: "3.12" }
          - { os: "ubuntu-latest", python-version: "3.13" }
          - { os: "ubuntu-latest", python-version: "3.14" }
          - { os: "windows-latest", python-version: "3.11" }
          - { os: "windows-latest", python-version: "3.12" }
          - { os: "windows-latest", python-version: "3.13" }
          - { os: "windows-latest", python-version: "3.14" }
    steps:
      # Check out the repository code to the runner
      - uses: "actions/checkout@v6" # https://github.com/marketplace/actions/checkout
      # Setup Python with the specified version from the matrix
      - uses: "actions/setup-python@v6" # https://github.com/marketplace/actions/setup-python
        with:
          python-version: "${{ matrix.python-version }}"
      # Install uv - fast Python package installer
      - name: "Install uv"
        uses: "astral-sh/setup-uv@v8.0.0" # https://github.com/marketplace/actions/setup-uv
      # Cache .venv directory to skip uv sync when dependencies unchanged
      - name: "Cache venv"
        uses: "actions/cache@v5"
        id: cache-venv
        with:
          path: .venv
          key: venv-${{ runner.os }}-${{ matrix.python-version }}-${{ hashFiles('uv.lock') }}
      # Install project dependencies using uv (skip if cache hit)
      - name: "Install dependencies"
        if: steps.cache-venv.outputs.cache-hit != 'true'
        run: uv sync --frozen --extra test
      # Optional: print the AWS CLI version if some tests run the "aws" command
      # (it is preinstalled on the GitHub-hosted runners)
      - name: "Show versions"
        run: |
          uv run --frozen python -VV
          aws --version
      # Run pytest with coverage reporting; the library must not trigger its
      # own deprecation warnings
      - name: "Run pytest"
        run: "uv run --frozen pytest tests -W error::DeprecationWarning --cov=${{ env.PACKAGE_NAME }} --cov-report=xml --cov-report term-missing"
      # Upload coverage report to Codecov, from the Linux jobs
      # For the first time setup, run "mise run setup-codecov", which sets the
      # CODECOV_TOKEN secret in GitHub actions
      - name: "Upload coverage to Codecov"
        if: "matrix.os == 'ubuntu-latest'"
        uses: "codecov/codecov-action@v5" # https://github.com/marketplace/actions/codecov
        with:
          token: ${{ secrets.CODECOV_TOKEN }} # Authentication token from repository secrets
          slug: ${{ github.repository }} # Repository identifier
          files: ./coverage.xml # Path to the coverage report generated by pytest
          flags: "py${{ matrix.python-version }}"
          verbose: true
          fail_ci_if_error: true # Fail the workflow if the Codecov upload fails
